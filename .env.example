APP_NAME="SkripsiLab AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skripsilabai.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_db_hosting
DB_USERNAME=user_db_hosting
DB_PASSWORD=password_db_hosting

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.skripsilabai.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@skripsilabai.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Providers & Research
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
SERPER_API_KEY=

# Google OAuth 2.0 (Update URI di Google Cloud Console ke https://skripsilabai.com/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://skripsilabai.com/auth/google/callback

# Admin Panel
ADMIN_PASSWORD=

# Payment Gateway (auto: pakai Mayar jika MAYAR_API_KEY diisi, else Pakasir, else WhatsApp Admin)
PAYMENT_GATEWAY=auto
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1

PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com

# Meta / Facebook Pixel & Conversions API
META_PIXEL_ID=1487586500131939
META_CAPI_TOKEN=
META_DOMAIN_VERIFICATION=

# Google Analytics 4 (GA4)
GA_MEASUREMENT_ID=G-NTF72X1K93

# iLoveAPI (iLovePDF & iLoveIMG — 2.500 kredit gratis/bulan: Word->PDF 1:1, Kompres PDF, Gabung PDF, Hapus BG AI)
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# Opsional: CloudConvert API untuk PDF -> Word 1:1 (gratis 25 konversi/hari, fallback lokal otomatis)
CLOUDCONVERT_API_KEY=

VITE_APP_NAME="${APP_NAME}"
